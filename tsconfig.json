{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": false,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "index.js",
    "types/**/*.d.ts"
  ],
  "exclude": ["lib/protocol/generated.js", "types/generated"]
}

{
  "name": "sen-ether-client",
  "version": "0.9.0",
  "description": "Pure JavaScript SEN Ether client for consuming and publishing SEN objects from Node.js",
  "senCompatibility": {
    "kernelProtocolVersion": 9,
    "etherProtocolVersion": 2
  },
  "type": "module",
  "main": "index.js",
  "types": "types/generated/index.d.ts",
  "bin": {
    "sen-ether-scan": "bin/node-sen-scan.js",
    "sen-ether-probe": "bin/node-sen-probe.js",
    "sen-stl-types": "bin/sen-stl-types.js"
  },
  "files": [
    "API.md",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md",
    "docs",
    "LICENSE",
    "LICENSES",
    "README.md",
    "index.js",
    "examples",
    "lib",
    "types",
    "bin",
    "resources"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mploscos/sen-ether-client.git"
  },
  "homepage": "https://github.com/mploscos/sen-ether-client#readme",
  "bugs": {
    "url": "https://github.com/mploscos/sen-ether-client/issues"
  },
  "keywords": [
    "sen",
    "ether",
    "stl",
    "hla",
    "fom",
    "telemetry",
    "distributed-objects"
  ],
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./types/generated/index.d.ts",
      "default": "./index.js"
    },
    "./interest-query": {
      "types": "./types/interest-query.d.ts",
      "default": "./lib/interest-query.js"
    },
    "./types": {
      "types": "./types/types.d.ts",
      "default": "./lib/types/index.js"
    }
  },
  "scripts": {
    "build:types": "node ./scripts/build-types.mjs",
    "check:protocol": "node ./scripts/generate-protocol.mjs --check",
    "generate:protocol": "node ./scripts/generate-protocol.mjs",
    "lint": "eslint .",
    "typecheck": "npm run build:types && tsc -p tsconfig.json && tsc -p tsconfig.declarations.json",
    "test": "node --test --test-concurrency=1 --test-reporter spec ./test/protocol.test.js ./test/codec.test.js ./test/discovery.test.js ./test/live-discovery.test.js ./test/client.test.js ./test/routing.test.js ./test/sen.test.js ./test/method-timeout.test.js ./test/stl.test.js ./test/types.test.js ./test/resource-limits.test.js",
    "test:handles": "node ./scripts/run-tests.mjs",
    "test:integration": "npm run test:integration:sen",
    "test:integration:sen": "node --test --experimental-test-isolation=none ./test/integration-hmi-diagnostics.test.js ./test/integration-publish.test.js ./test/integration-reconnect.test.js",
    "test:compat": "node --test --experimental-test-isolation=none ./test/integration-rpr.test.js",
    "test:network": "node ./scripts/run-network-tests.mjs",
    "test:package": "node ./scripts/test-package.mjs",
    "test:soak": "node --test --experimental-test-isolation=none ./test/soak.test.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.3",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "typescript": "^7.0.2"
  }
}
